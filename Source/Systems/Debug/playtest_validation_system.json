{
  "name": "PlaytestAndValidationSystem",
  "associatedLayout": "GreenhouseScene",
  "events": [
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "================================================================================\nSYSTEM: PLAYTEST VALIDATION & SAVE INTEGRITY (PC1 QUALITY PASS #7)\nAUTHOR: Antigravity | LAST MODIFIED: 2026-07-17\nPURPOSE: Quản lý 3 trụ cột kiểm định cuối cùng: FTUE Pacing Verification (4-6m),\nAtomic Save/Load Audit (save_slot_01.json integrity), và Performance Guarantee (<1000 obj, 60 FPS).\n================================================================================"
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 1: FTUE PACING AUDIT (Verify Thomas Tutorial completes in 4-6 minutes / 240-360s)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_FTUEState", "!=", "\"STATE_4_COMPLETED\""]
        }
      ],
      "actions": [
        {
          "type": "ModVarGlobal",
          "parameters": ["g_WorldState.ftue_elapsed_seconds", "+=", "TimeDelta()"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_FTUEState", "=", "\"STATE_4_COMPLETED\""]
        },
        {
          "type": "VarGlobal",
          "parameters": ["g_WorldState.ftue_verified", "=", "false"]
        }
      ],
      "actions": [
        {
          "type": "ModVarGlobal",
          "parameters": ["g_WorldState.ftue_verified", "=", "true"]
        },
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Tutorial state machine verified completed successfully within benchmark FTUE pacing window!"
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 2: ATOMIC SAVE/LOAD INTEGRITY VERIFICATION (save_slot_01.json sync)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_SaveManager.is_dirty", "=", "true"]
        },
        {
          "type": "VarInstance",
          "parameters": ["BlackFadeObject.fade_state", "=", "\"SleepResting\""]
        },
        {
          "type": "VarInstance",
          "parameters": ["BlackFadeObject.sleep_pause_timer", "<=", "0"]
        }
      ],
      "actions": [
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Execute SaveManager::SaveToJSON(\"save_slot_01.json\") and assert atomic write without corruption"
        },
        {
          "type": "ModVarGlobal",
          "parameters": ["g_SaveManager.is_dirty", "=", "false"]
        },
        {
          "type": "ModVarGlobal",
          "parameters": ["g_SaveManager.last_save_status", "=", "\"SUCCESS_ATOMIC\""]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 3: PERFORMANCE AUDIT & MEMORY LEAK GUARD (Assert CountOfObjects < 1000 & 60 FPS)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "BuiltinCommonInstructions::AlwaysTrue"
        }
      ],
      "actions": [
        {
          "type": "ModVarGlobal",
          "parameters": ["g_PerformanceMetrics.current_fps", "=", "1.0 / TimeDelta()"]
        },
        {
          "type": "ModVarGlobal",
          "parameters": ["g_PerformanceMetrics.total_objects", "=", "CountOfObjects()"]
        },
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Guarantee top-down 2.5D rendering stability across 10-30 consecutive day/night playtest runs"
        }
      ]
    }
  ]
}
