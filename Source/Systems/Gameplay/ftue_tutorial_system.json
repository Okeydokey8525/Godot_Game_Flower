{
  "name": "FTUETutorialSystem",
  "associatedLayout": "GreenhouseScene",
  "events": [
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "================================================================================\nSYSTEM: FIRST-TIME USER EXPERIENCE (FTUE) & TUTORIAL LOOP (5 POLISH ITEMS)\nAUTHOR: Antigravity | LAST MODIFIED: 2026-07-17\nPURPOSE: Quản lý 5 phút tutorial: Typewriter Dialogue, NPC Facing Player, Camera\nZoom 1.1, Checklist Animation Ding! ✔, và KHÔNG save ngay khi xong tutorial!\n================================================================================"
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 1: INITIALIZATION & TUTORIAL STATE SETUP"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "BuiltinCommonInstructions::AtBeginningOfScene"
        }
      ],
      "actions": [
        {
          "type": "ModVarGlobal",
          "parameters": ["g_TutorialState", "=", "0"]
        },
        {
          "type": "ModVarGlobal",
          "parameters": ["g_DialogTypewriterIndex", "=", "0"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 2: TYPEWRITER DIALOGUE EFFECT & CAMERA ZOOM FOCUS (Polish #1 & #3)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarInstance",
          "parameters": ["DialogBoxObject.is_open", "=", "true"]
        }
      ],
      "actions": [
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Increment typewriter character index every frame and slice string: sub_string(full_string, 0, g_DialogTypewriterIndex)"
        },
        {
          "type": "Camera::SetZoom",
          "parameters": ["", "1.1", "", "0"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarInstance",
          "parameters": ["DialogBoxObject.is_open", "=", "true"]
        },
        {
          "type": "Keyboard::KeyReleased",
          "parameters": ["", "\"Space\""]
        }
      ],
      "actions": [
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "If Space pressed during typewriter -> instantly reveal full text or close dialog -> Reset camera zoom to 1.0"
        },
        {
          "type": "Camera::SetZoom",
          "parameters": ["", "1.0", "", "0"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 3: NPC FACING DIRECTION TOWARDS PLAYER (Polish #2)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_EventBusQueue.has_signal(\"InteractNPC\")", "=", "true"]
        },
        {
          "type": "VarGlobal",
          "parameters": ["g_EventBusQueue.get_signal_payload(\"InteractNPC\").target_id", "=", "\"thomas\""]
        }
      ],
      "actions": [
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Calculate angle from NPCThomasObject to PlayerObject -> set animation direction (South/North/East/West)"
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 4: PROGRESS OBJECTIVE CHECKLIST ANIMATION & SFX DING (Polish #4)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_TutorialState", "=", "3"]
        }
      ],
      "actions": [
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Planting completed -> Play SFX 'Ding' -> Show [x] Plant ✔ -> Highlight [ ] Water"
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 5: STEP 1 & 2 — THOMAS DIALOGUE & RECEIVE SEEDS"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_EventBusQueue.has_signal(\"InteractNPC\")", "=", "true"]
        },
        {
          "type": "VarGlobal",
          "parameters": ["g_TutorialState", "=", "0"]
        }
      ],
      "actions": [
        {
          "type": "ModVarGlobal",
          "parameters": ["g_TutorialState", "=", "2"]
        },
        {
          "type": "ModVarInstance",
          "parameters": ["NPCThomasObject.has_quest_indicator", "=", "false"]
        },
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Open DialogBoxObject with Typewriter -> EventBus.Emit(\"InventoryAddRequest\", { item_id: \"item_seed_white_lily\", quantity: 5 })"
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 6: STEP 5 & 6 — HARVEST COMPLETION (NO INSTANT SAVE — Polish #5)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_EventBusQueue.has_signal(\"FlowerHarvested\")", "=", "true"]
        },
        {
          "type": "VarGlobal",
          "parameters": ["g_TutorialState", "=", "4"]
        }
      ],
      "actions": [
        {
          "type": "ModVarGlobal",
          "parameters": ["g_TutorialState", "=", "6"]
        },
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Emit EconomyAddGoldRequest for 100 Gold -> Display congratulations -> NO DISK WRITE! Save deferred to Bed/Sleep in Sprint 3.6!"
        }
      ]
    }
  ]
}
