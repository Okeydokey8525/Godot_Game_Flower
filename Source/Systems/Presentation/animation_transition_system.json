          "type": "ModVarInstance",
          "parameters": ["BlackFadeObject.fade_state", "=", "\"SleepResting\""]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 4: SLEEP RESTING TIMER -> DAY ADVANCE & ATOMIC AUTOSAVE"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarInstance",
          "parameters": ["BlackFadeObject.fade_state", "=", "\"SleepResting\""]
        },
        {
          "type": "VarInstance",
          "parameters": ["BlackFadeObject.sleep_pause_timer", ">", "0"]
        }
      ],
      "actions": [
        {
          "type": "ModVarInstance",
          "parameters": ["BlackFadeObject.sleep_pause_timer", "-=", "TimeDelta()"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarInstance",
          "parameters": ["BlackFadeObject.fade_state", "=", "\"SleepResting\""]
        },
        {
          "type": "VarInstance",
          "parameters": ["BlackFadeObject.sleep_pause_timer", "<=", "0"]
        }
      ],
      "actions": [
        {
          "type": "ModVarGlobal",
          "parameters": ["g_WorldState.current_day", "+=", "1"]
        },
        {
          "type": "ModVarGlobal",
          "parameters": ["g_WorldState.current_hour", "=", "6"]
        },
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Atomic Autosave Hook if dirty -> SaveManager.Save()"
        },
        {
          "type": "ModVarInstance",
          "parameters": ["DailySummaryBoxObject.is_open", "=", "true"]
        },
        {
          "type": "ModVarInstance",
          "parameters": ["BlackFadeObject.fade_state", "=", "\"SummaryWaiting\""]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 5: WAKE UP FADE IN TRANSITION"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarInstance",
          "parameters": ["BlackFadeObject.fade_state", "=", "\"FadeIn\""]
