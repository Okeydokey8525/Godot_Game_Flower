{
  "name": "AudioAndSoundFeelSystem",
  "associatedLayout": "GreenhouseScene",
  "events": [
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "================================================================================\nSYSTEM: AUDIO & SOUND FEEL POLISH (PC1 QUALITY PASS #3)\nAUTHOR: Antigravity | LAST MODIFIED: 2026-07-17\nPURPOSE: Quản lý 3 trụ cột âm thanh: Footstep Cadence (bước chân mỗi 0.35s),\nFarming SFX Hooks (Plant, Water, Harvest Chime), và Economy/Sleep BGM Hooks.\n================================================================================"
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 1: FOOTSTEP CADENCE TIMER & WALKING SFX (Every 0.35s when moving)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarInstance",
          "parameters": ["PlayerObject.is_moving", "=", "true"]
        },
        {
          "type": "VarInstance",
          "parameters": ["PlayerObject.is_busy", "=", "false"]
        },
        {
          "type": "VarInstance",
          "parameters": ["PlayerObject.footstep_timer", ">", "0"]
        }
      ],
      "actions": [
        {
          "type": "ModVarInstance",
          "parameters": ["PlayerObject.footstep_timer", "-=", "TimeDelta()"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarInstance",
          "parameters": ["PlayerObject.is_moving", "=", "true"]
        },
        {
          "type": "VarInstance",
          "parameters": ["PlayerObject.is_busy", "=", "false"]
        },
        {
          "type": "VarInstance",
          "parameters": ["PlayerObject.footstep_timer", "<=", "0"]
        }
      ],
      "actions": [
        {
          "type": "PlaySound",
          "parameters": ["\"Assets/Audio/SFX/sfx_footstep_grass.wav\"", "false", "40", "1.0"]
        },
        {
          "type": "ModVarInstance",
          "parameters": ["PlayerObject.footstep_timer", "=", "0.35"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarInstance",
          "parameters": ["PlayerObject.is_moving", "=", "false"]
        }
      ],
      "actions": [
        {
          "type": "ModVarInstance",
          "parameters": ["PlayerObject.footstep_timer", "=", "0"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 2: FARMING ACTION SFX HOOKS (Plant Seed, Water Splash, Harvest Chime)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_EventBusQueue.has_signal(\"InteractSoil\")", "=", "true"]
        },
        {
          "type": "BuiltinCommonInstructions::Comment",
          "comment": "Check if player has a seed bag selected"
        }
      ],
      "actions": [
        {
          "type": "PlaySound",
          "parameters": ["\"Assets/Audio/SFX/sfx_plant_seed.wav\"", "false", "80", "1.0"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_EventBusQueue.has_signal(\"FlowerHarvested\")", "=", "true"]
        }
      ],
      "actions": [
        {
          "type": "PlaySound",
          "parameters": ["\"Assets/Audio/SFX/sfx_harvest_chime.wav\"", "false", "100", "1.0"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Comment",
      "comment": "BLOCK 3: ECONOMY & SLEEP/BGM HOOKS (Coin Clink, Lullaby, Rooster & Morning BGM)"
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_EventBusQueue.has_signal(\"EconomyAddGoldRequest\")", "=", "true"]
        }
      ],
      "actions": [
        {
          "type": "PlaySound",
          "parameters": ["\"Assets/Audio/SFX/sfx_coin_clink.wav\"", "false", "90", "1.0"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarGlobal",
          "parameters": ["g_EventBusQueue.has_signal(\"InteractBed\")", "=", "true"]
        }
      ],
      "actions": [
        {
          "type": "PlaySound",
          "parameters": ["\"Assets/Audio/SFX/sfx_sleep_lullaby.wav\"", "false", "70", "1.0"]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": "VarInstance",
          "parameters": ["BlackFadeObject.fade_state", "=", "\"FadeIn\""]
        },
        {
          "type": "VarInstance",
          "parameters": ["BlackFadeObject.opacity", ">=", "250"]
        }
      ],
      "actions": [
        {
          "type": "PlaySound",
          "parameters": ["\"Assets/Audio/SFX/sfx_day_start_rooster.wav\"", "false", "80", "1.0"]
        },
        {
          "type": "PlayMusicFile",
          "parameters": ["\"Assets/Audio/BGM/bgm_morning_greenhouse.ogg\"", "true", "60", "1.0"]
        }
      ]
    }
  ]
}
